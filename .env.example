# Copy this file to .env for local Docker Compose.
# Do not commit real credentials.

# The site consumes the separately deployed cj-stats API.
# Override this URL when developing against another API instance.
VITE_API_BASE_URL=https://api.jump4life.org

# Optional benchmark transport. Unset keeps the production-compatible v1 JSON default.
# VITE_API_FORMAT=msgpack

# Optional: exercise locally developed replay routes without sending map,
# leaderboard, player, or server requests to an incomplete local database.
# Replay totals still reflect the local backend's configured database snapshot.
# VITE_REPLAY_API_BASE_URL=http://127.0.0.1:8080

# Optional: HTTPS origin (and path) serving web-ready 3D map models as <mapname>.glb
# (meshopt-compressed, WebP textures), plus viewmodel/<weapon>.glb and sounds/sounds.json with its
# WAV files for replays. Unset hides the 3D map view and replay links.
# The host must allow cross-origin GET requests from this site.
# VITE_MAP_MODEL_BASE_URL=https://models.example.com/maps
# Local development only (see README): VITE_MAP_MODEL_BASE_URL=http://127.0.0.1:8090

# Optional: "1" turns on anonymous web replay-view analytics (ADR 0005): the replay player posts
# playback statistics to the replay API, and replay pages show view counts and the watch heat.
# Browsers that send Do Not Track or Global Privacy Control are never counted.
# VITE_REPLAY_VIEW_ANALYTICS=1
