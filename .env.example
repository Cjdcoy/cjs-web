# Copy this file to .env for local Docker Compose.
# Do not commit real credentials.

# The site consumes the separately deployed cj-stats API.
# Override this URL when developing against another API instance.
VITE_API_BASE_URL=https://api.jump4life.org

# Optional: exercise locally developed replay routes without sending map,
# leaderboard, player, or server requests to an incomplete local database.
# Replay totals still reflect the local backend's configured database snapshot.
# VITE_REPLAY_API_BASE_URL=http://127.0.0.1:8080
