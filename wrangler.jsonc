{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cjs-web",
  "compatibility_date": "2026-08-15",
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  // The Worker is the origin for this hostname, so Wrangler manages its DNS.
  "routes": [{ "pattern": "stats.jump4life.org", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
