{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cjs-web",
  "compatibility_date": "2026-08-15",
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  // stats.jump4life.org is attached to this Worker as a custom domain out of
  // band. Keeping it out of here means CI's token needs Workers Scripts: Edit
  // and nothing else -- no DNS or Workers Routes permission on the zone.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
